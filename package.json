{
  "name": "google-chrome-bookmarks",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "nx serve",
    "lint": "eslint ./src \"src/**/*.ts\" \"src/**/*.html\" \"e2e/**/*.ts\" \"*.ts\"",
    "build": "npm run version-info && nx build && npx tsc --ignoreConfig src/background.ts --types chrome --outDir dist/bookmarks/browser --target es2022 --module es2022 --moduleResolution bundler && npm run verify:extension",
    "build:extension": "pwsh -File ./scripts/build-extension.ps1",
    "verify:extension": "node scripts/verify-extension.mjs",
    "benchmark": "tsx benchmarks/favicon.benchmark.ts",
    "benchmark:bookmarks": "tsx benchmarks/large-library.benchmark.ts",
    "watch": "nx build --watch --configuration development",
    "test": "umask 0002 && nx test --watch=false && npx playwright test",
    "test:unit": "umask 0002 && nx test --watch=false",
    "test:e2e": "umask 0002 && npx playwright test",
    "test:e2e:visible": "umask 0002 && PLAYWRIGHT_SLOW_MO=${PLAYWRIGHT_SLOW_MO:-300} npx playwright test --headed --workers=1",
    "postinstall": "npx playwright install && npm run version-info",
    "affected:lint": "nx affected:lint",
    "start:dev": "nx run-many --target=build --all --configuration development --watch --parallel 5",
    "start:prod": "nx run-many --target=build --all --configuration production --watch --parallel 5",
    "version-info": "node ./scripts/git-version.mjs .",
    "build:dev": "npm run version-info && nx run-many --target=build --all --configuration development --parallel 5 && npx tsc --ignoreConfig src/background.ts --types chrome --outDir dist/bookmarks/browser --target es2022 --module es2022 --moduleResolution bundler && npm run verify:extension",
    "build:prod": "npm run version-info && nx run-many --target=build --all --configuration production --parallel 5 && npx tsc --ignoreConfig src/background.ts --types chrome --outDir dist/bookmarks/browser --target es2022 --module es2022 --moduleResolution bundler && npm run verify:extension"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.2.0",
    "@angular/cdk": "22.2.0",
    "@angular/common": "22.2.0",
    "@angular/compiler": "22.2.0",
    "@angular/core": "22.2.0",
    "@angular/forms": "22.2.0",
    "@angular/platform-browser": "22.2.0",
    "@angular/router": "22.2.0",
    "@ngrx/signals": "22.0.1",
    "@types/chrome": "^0.3.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.3"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.7.4",
    "@analogjs/vitest-angular": "2.7.4",
    "@angular-devkit/core": "22.2.0",
    "@angular-devkit/schematics": "22.2.0",
    "@angular/build": "22.2.0",
    "@angular/cli": "22.2.0",
    "@angular/compiler-cli": "22.2.0",
    "@eslint/js": "^10.0.1",
    "@nx/angular": "23.2.1",
    "@nx/eslint": "23.2.1",
    "@nx/vitest": "23.2.1",
    "@nx/workspace": "23.2.1",
    "@playwright/test": "^1.63.0",
    "@schematics/angular": "22.2.0",
    "angular-eslint": "22.5.0",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.1",
    "nx": "23.2.1",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  }
}
