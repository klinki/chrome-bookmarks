{
  "name": "google-chrome-bookmarks",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "nx serve",
    "build": "npm run version-info && nx build && npx tsc src/background.ts --outDir dist/bookmarks --target es2022 --module es2022 --moduleResolution node",
    "benchmark": "tsx benchmarks/favicon.benchmark.ts",
    "watch": "nx build --watch --configuration development",
    "test": "umask 0002 && nx test --watch=false && npx playwright test",
    "test:unit": "umask 0002 && nx test --watch=false",
    "test:e2e": "umask 0002 && npx playwright test",
    "test:e2e:visible": "umask 0002 && PLAYWRIGHT_SLOW_MO=${PLAYWRIGHT_SLOW_MO:-300} npx playwright test --headed --workers=1",
    "lint": "nx lint bookmarks",
    "postinstall": "npx playwright install && npm run version-info",
    "affected:lint": "nx affected:lint",
    "start:dev": "nx run-many --target=build --all --configuration development --watch --parallel 5",
    "start:prod": "nx run-many --target=build --all --configuration production --watch --parallel 5",
    "version-info": "node ./scripts/git-version.mjs .",
    "build:dev": "npm run version-info && nx run-many --target=build --all --configuration development --parallel 5 && npx tsc src/background.ts --outDir dist/bookmarks --target es2022 --module es2022 --moduleResolution node",
    "build:prod": "npm run version-info && nx run-many --target=build --all --configuration production --parallel 5 && npx tsc src/background.ts --outDir dist/bookmarks --target es2022 --module es2022 --moduleResolution node"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "21.0.7",
    "@angular/cdk": "21.0.5",
    "@angular/common": "21.0.7",
    "@angular/compiler": "21.0.7",
    "@angular/core": "21.0.7",
    "@angular/forms": "21.0.7",
    "@angular/platform-browser": "21.0.7",
    "@angular/router": "21.0.7",
    "@ngrx/signals": "21.0.1",
    "@types/chrome": "^0.0.246",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.2.2",
    "@analogjs/vitest-angular": "^2.2.2",
    "@angular-devkit/build-angular": "21.0.5",
    "@angular-devkit/core": "21.0.5",
    "@angular-devkit/schematics": "21.0.5",
    "@angular/cli": "21.0.5",
    "@angular/compiler-cli": "21.0.7",
    "@eslint/js": "^9.39.5",
    "@nx/angular": "22.3.3",
    "@nx/eslint": "22.3.3",
    "@nx/vitest": "22.3.3",
    "@nx/workspace": "22.3.3",
    "@playwright/test": "^1.57.0",
    "@schematics/angular": "21.0.5",
    "angular-eslint": "21.4.0",
    "eslint": "^9.39.5",
    "jsdom": "^27.4.0",
    "nx": "22.3.3",
    "tsx": "^4.23.11",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.8"
  }
}
